on init
    # The legacy kernel exposes these nodes with the generic sysfs label.
    # Apply Oreo's labels before rmt_storage and other core services start.
    restorecon /sys/power/wake_lock /sys/power/wake_unlock
    restorecon /sys/module/wlan/parameters/fwpath
    restorecon /sys/devices/platform/wcnss_wlan.0/serial_number
    restorecon /sys/module/hci_smd/parameters/hcismd_set
    restorecon /sys/devices/platform/bt_power.0/rfkill/rfkill0/state

on post-fs
    restorecon /persist/.bt_nv.bin
    restorecon /persist/WCNSS_qcom_cfg.ini
    restorecon /persist/WCNSS_qcom_wlan_nv_calibration_persist.bin /persist/WCNSS_qcom_wlan_nv_regulatory_persist.bin
    # Obake setup script
    exec /init.obake.sh

# The root SU6-7.7 RIL creates its private IMS socket with init's 077 umask.
# Repair only that already-created endpoint when the phone-UID adapter reports
# EACCES, then reset the trigger so a later RIL restart can request it again.
on property:sys.ims.rild_socket_fix=1
    chown root radio /dev/socket/qmux_radio/rild_ims
    chmod 0660 /dev/socket/qmux_radio/rild_ims
    setprop sys.ims.rild_socket_fix 0
