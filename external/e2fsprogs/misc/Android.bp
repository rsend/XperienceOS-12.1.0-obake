//########################################################################
// Build lsattr



lsattr_libs = [
    "libext2_com_err",
    "libext2_e2p",
]





//########################################################################
// Build blkid

cc_binary {
    name: "blkid",

    srcs: ["blkid.c"],
    cflags: ["-W", "-Wall", "-Wno-macro-redefined"],
    shared_libs: [
        "libext2fs",
        "libext2_blkid",
        "libext2_com_err",
        "libext2_e2p",
    ],
    system_shared_libs: ["libc", "libdl"],
}

