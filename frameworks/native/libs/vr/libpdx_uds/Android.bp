cc_library_static {
    name: "libpdx_uds",
    clang: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DLOG_TAG=\"libpdx_uds\"",
        "-DTRACE=0",
    ],
    export_include_dirs: ["private"],
    local_include_dirs: ["private"],
    srcs: [
        "channel_event_set.cpp",
        "channel_manager.cpp",
        "client_channel_factory.cpp",
        "client_channel.cpp",
        "ipc_helper.cpp",
        "service_endpoint.cpp",
    ],
    static_libs: [
        "libcutils",
        "libbase",
        "libpdx",
    ],
    whole_static_libs: [
        "libselinux",
    ],
}


