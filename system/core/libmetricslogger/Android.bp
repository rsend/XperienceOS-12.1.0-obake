// Copyright 2017 The Android Open Source Project

metricslogger_lib_src_files = [
    "metrics_logger.cpp",
]

cc_defaults {
    name: "metricslogger_defaults",

    clang: true,
    host_supported: true,

    export_include_dirs: ["include"],
    local_include_dirs: ["include"],
    shared_libs: ["liblog"],
    whole_static_libs: ["libgtest_prod"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",

        // The following define maps the sysui_multi_action logtag ID as represented by:
        //   frameworks/base/core/java/com/android/internal/logging/EventLogTags.logtags
        //
        // TODO(jhawkins): Query this value at runtime.
        "-DMULTI_ACTION_LOG_TAG=524292",
    ],
}

// metricslogger shared library
// -----------------------------------------------------------------------------
cc_library_shared {
    name: "libmetricslogger",
    srcs: metricslogger_lib_src_files,
    defaults: ["metricslogger_defaults"],
}

